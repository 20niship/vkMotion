<?xml version="1.0"?>
<!--
  SO-101 (TheRobotStudio/SO-ARM100, Simulation/SO101/so101_new_calib.urdf, 6-DoF)
  joint kinematics, simplified for vkMotion collision testing:
    - visual mesh geometry omitted
    - collision geometry approximated with box/sphere primitives (not exact CAD)
  Joint origins/axes/limits copied verbatim from the upstream URDF:
    https://github.com/TheRobotStudio/SO-ARM100 Simulation/SO101/so101_new_calib.urdf
-->
<robot name="so101">
  <link name="base_link">
    <collision>
      <geometry><box size="0.07 0.07 0.05"/></geometry>
    </collision>
  </link>
  <link name="shoulder_link">
    <collision>
      <geometry><box size="0.045 0.04 0.07"/></geometry>
    </collision>
  </link>
  <link name="upper_arm_link">
    <collision>
      <geometry><box size="0.12 0.035 0.035"/></geometry>
    </collision>
  </link>
  <link name="lower_arm_link">
    <collision>
      <geometry><box size="0.135 0.035 0.03"/></geometry>
    </collision>
  </link>
  <link name="wrist_link">
    <collision>
      <geometry><box size="0.04 0.035 0.06"/></geometry>
    </collision>
  </link>
  <link name="gripper_link">
    <collision>
      <geometry><box size="0.035 0.03 0.05"/></geometry>
    </collision>
  </link>
  <link name="moving_jaw_so101_v1_link">
    <collision>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0.0388353 -0.00000000897657 0.0624" rpy="3.14159 0 -3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.91986" upper="1.91986" effort="10" velocity="10"/>
  </joint>
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.74533" upper="1.74533" effort="10" velocity="10"/>
  </joint>
  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <origin xyz="-0.11257 -0.028 0" rpy="0 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.69" upper="1.69" effort="10" velocity="10"/>
  </joint>
  <joint name="wrist_flex" type="revolute">
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <origin xyz="-0.1349 0.0052 0" rpy="0 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.65806" upper="1.65806" effort="10" velocity="10"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.74385" upper="2.84121" effort="10" velocity="10"/>
  </joint>
  <joint name="gripper" type="revolute">
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.174533" upper="1.74533" effort="10" velocity="10"/>
  </joint>
</robot>
