#version 450
#extension GL_GOOGLE_include_directive : enable

// GPU RRT-Connectのラウンド間処理(問題ごとに1ワークグループ。workgroup IDが問題番号)。ラウンド番号を進め、解けていれば次のdispatchを0本にし、
// そうでなければ木のスナップショット(これ未満のノードだけ次ラウンドで読める)を更新して、次ラウンドのワープ数を決める。
// 最初のラウンドでは根ノード(start / goals)も書く。

layout(local_size_x = 32) in;

#include "include/rrt_common.glsl"

void main() {
  const uint t = gl_LocalInvocationID.x;
  init_problem(gl_WorkGroupID.x);
  init_quant();
  const uint ngoals = floatBitsToUint(PRM(PRM_NGOALS));
  const uint r = CTL(CTL_ROUND);
  if(r == 0u) {
    float q[8];
    if(t == 0u) {
      for(uint j = 0; j < 8u; j++) q[j] = PRM(24u + j);
      NODE(0u, 0u) = pack_node(q, -1);
    }
    if(t < ngoals) {
      for(uint j = 0; j < 8u; j++) q[j] = PRM(32u + t * 8u + j);
      NODE(1u, t) = pack_node(q, -1);
    }
  }
  barrier();
  if(t != 0u) return;

  CTL(CTL_ROUND) = r + 1u;
  if(CTL(CTL_SOLVED) >= pc.gen) {
    CTL(CTL_ARGS) = 0u;
    return;
  }
  uint c0 = CTL(CTL_CNT0), c1 = CTL(CTL_CNT1);
  // 余裕: 最初は pc.margin。片方の木がもう片方の1/12未満しか伸びていなければ(端点が障害物すれすれ)、2ラウンドごとに 1/4 -> 0 と縮める。
  // それまでに木に入れたノードは大きい余裕のものなので、縮めても有効。
  float margin = r == 0u ? pc.margin : uintBitsToFloat(CTL(CTL_MARGIN));
  if(r >= 3u && margin > 0.0 && r >= CTL(CTL_STAGE) + 2u && min(c0, c1 - ngoals + 1u) * 12u < max(c0, c1 - ngoals + 1u)) {
    // 1/4 までは早めに、0(障害物に接する経路を許す)は長く止まったときだけ(別の検証器で見たとき食い込む経路が増えるため)
    if(margin > 0.3 * pc.margin) margin = 0.25 * pc.margin;
    else if(r >= 12u) margin = 0.0;
    CTL(CTL_STAGE) = r;
  }
  CTL(CTL_MARGIN) = floatBitsToUint(margin);
  if(r == 0u || c0 > CAP_SOFT || c1 > CAP_SOFT) {
    c0 = 1u;
    c1 = ngoals;
  }
  c0 = min(c0, CAP);
  c1 = min(c1, CAP);
  CTL(CTL_CNT0)  = c0;
  CTL(CTL_CNT1)  = c1;
  CTL(CTL_SNAP0) = c0;
  CTL(CTL_SNAP1) = c1;
  uint g = pc.g0 << min(r / max(pc.grow, 1u), 16u);
  g      = min(g, pc.gmax);
  CTL(CTL_ARGS) = g;
}
